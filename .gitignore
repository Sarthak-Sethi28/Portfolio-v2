# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local dev
.vercel
*.tsbuildinfo

# generated bundle for external review
signal-array-src.zip

# Blender: the bpy venv is ~1GB of binary, rebuilt by scripts/README
.blender-venv/
# Uncompressed Blender sources: 14MB each, regenerated by scripts/split-portal.mjs
assets/blender/base_basic_pbr.glb
assets/blender/base_split.glb
